{
  "$schema": "https://railway.app/railway.schema.json",
  "build": {
    "builder": "DOCKERFILE",
    "dockerfilePath": "Dockerfile"
  },
  "deploy": {
    "startCommand": "node dist/serve-example.js",
    "healthcheckPath": "/health",
    "healthcheckTimeout": 30,
    "restartPolicyType": "ON_FAILURE",
    "restartPolicyMaxRetries": 3
  },
  "_env": {
    "RIPAR_PAY_TO": "REQUIRED - your Algorand address; the server refuses to boot without it",
    "RIPAR_NETWORK": "testnet or mainnet"
  }
}
