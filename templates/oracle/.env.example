# Settlement lands here directly. 58 base32 characters, and it must be yours.
RIPAR_PAY_TO=

# Signs every quote. NOT the payout address — this key is used on every call, so
# it lives hotter and should be rotatable on its own. It needs no balance; it
# only signs bytes and never sends a transaction.
ORACLE_MNEMONIC=

RIPAR_NETWORK=testnet
PORT=4021
